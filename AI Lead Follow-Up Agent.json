      ],
      "id": "d337a85f-7cc9-4163-86ca-ca64b9c3a02c",
      "name": "Build API Body"
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst aiText = inputData.candidates[0].content.parts[0].text;\n\nfunction tryParseJSON(str) {\n  // Remove possible markdown fences\n  let cleaned = str.replace(/```json|```/g, '').trim();\n  // Standard parse\n  try { return JSON.parse(cleaned); } catch(e) {}\n  // If standard fails, try a fallback (default to Cold)\n  return {\n    score: \"Cold\",\n    competitor_detected: false,\n    competitor_name: null,\n    reply_subject: \"Thank you for your message\",\n    reply_body: \"Thank you for reaching out. We will get back to you shortly.\"\n  };\n}\n\nconst aiJson = tryParseJSON(aiText);\n\nconst leadNode = $('GetPrompt').first().json;\n\nreturn {\n  score: aiJson.score,\n  competitor_detected: aiJson.competitor_detected,\n  competitor_name: aiJson.competitor_name,\n  reply_subject: aiJson.reply_subject,\n  reply_body: aiJson.reply_body,\n  lead_name: leadNode.lead_name,\n  lead_email: leadNode.lead_email,\n  lead_message: leadNode.lead_message\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "c976eb03-f1ae-4a32-b381-ea55ef4f99c3",
      "name": "Parse&Lead"
