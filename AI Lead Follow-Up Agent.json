      "id": "0d0ed4a4-f472-4fc3-8b2a-d60c7fc58389",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.apiBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        832,
        0
      ],
      "id": "ff5496a3-0aed-4f94-afed-4cca2350c014",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst prompt = \"You are a professional sales assistant for a software development company. A new lead has contacted us. Read their message carefully and do the following:\\n\\nLEAD MESSAGE:\\n\" +\n  lead.lead_message + \"\\n\\nLEAD NAME:\\n\" + lead.lead_name + \"\\n\\nYOUR TASKS:\\n\\n\" +\n  \"1. QUALIFY this lead. Score them as:\\n\" +\n  \"   - \\\"Hot\\\" = clear project need + budget signals + urgency\\n\" +\n  \"   - \\\"Warm\\\" = has a project idea but vague on budget/timeline\\n\" +\n  \"   - \\\"Cold\\\" = just asking questions, no clear project, student, or spam\\n\\n\" +\n  \"2. DETECT if the lead mentions any competitor company. If yes, note it.\\n\\n\" +\n  \"3. WRITE a personalized, professional reply email that:\\n\" +\n  \"   - If a company name is mentioned or can be inferred from the email, address the company (e.g., \\\"Hi Exness,\\\"). Otherwise, use a neutral greeting like \\\"Hi there,\\\" or \\\"Hello,\\\". Do NOT address the recipient by their personal name.\\n\" +\n  \"   - References their specific project/need from their message\\n\" +\n  \"   - Shows genuine understanding of their problem\\n\" +\n  \"   - Is warm but professional (not salesy)\\n\" +\n  \"   - If competitor detected: include ONE subtle line positioning us favorably (do not attack the competitor)\\n\" +\n  \"   - Ends with an invitation to book a discovery call\\n\\n\" +\n  \"IMPORTANT: Your entire response must be a single, valid JSON object.\\n\" +\n  \"Make sure to escape any double quotes (\\\") inside string values with a backslash (\\\\\\\").\\n\" +\n  \"Do not include any additional text, only the JSON object.\\n\\n\" +\n  \"RESPOND ONLY IN THIS JSON FORMAT — no extra text:\\n\" +\n  \"{\\n  \\\"score\\\": \\\"Hot\\\" or \\\"Warm\\\" or \\\"Cold\\\",\\n  \\\"competitor_detected\\\": true or false,\\n  \\\"competitor_name\\\": \\\"name or null\\\",\\n  \\\"reply_subject\\\": \\\"email subject line here\\\",\\n  \\\"reply_body\\\": \\\"full email reply here\\\"\\n}\";\n\nreturn {\n  promptText: prompt,\n  lead_name: lead.lead_name,\n  lead_email: lead.lead_email,\n  lead_message: lead.lead_message\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "b7270427-a39b-4b23-9080-488026f1bec8",
      "name": "GetPrompt"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bc7511cc-cc0a-44d5-94a8-27d29c5cb7d1",
              "name": "apiBody",
              "value": "={{ JSON.stringify({ contents: [ { parts: [ { text: $json.promptText } ] } ] }) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        624,
